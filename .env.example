# Kopieer dit bestand naar ".env" en vul je eigen waarden in.
# Zie README.md voor hoe je die ophaalt.

MINDTICKLE_SUBDOMAIN=directresultmarketing
MINDTICKLE_MANAGER_ID=1d01175d93e48000

# Plak hier lokaal de VOLLEDIGE cookie-header uit je browser.
MINDTICKLE_COOKIE=

# Optioneel pad naar een HAR met request cookies.
MINDTICKLE_HAR=

# Drempelwaarde in procenten die telt als "voldoende"
SCORE_THRESHOLD=50
